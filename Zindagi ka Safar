<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="A live digital clock showing the current time in cities around the world.">
  <title>World Clock</title>
  <style>
    :root {
      color-scheme: dark;
      --background: #0b1020;
      --surface: #141c30;
      --surface-raised: #1b2740;
      --text: #f3f6ff;
      --muted: #9eacc8;
      --accent: #76e4c2;
      --border: rgba(180, 198, 232, .14);
    }

    * { box-sizing: border-box; }
    body {
      min-height: 100vh;
      margin: 0;
      padding: 48px 20px;
      background: radial-gradient(ellipse at top, #17264a 0, var(--background) 55%);
      color: var(--text);
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    main { width: min(1050px, 100%); margin: 0 auto; }
    .heading { margin-bottom: 30px; text-align: center; }
    .eyebrow { color: var(--accent); font-size: .78rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
    h1 { margin: 8px 0; font-size: clamp(2rem, 6vw, 3.5rem); }
    .intro { margin: 0; color: var(--muted); }
    .clock-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }
    .clock-card {
      min-height: 175px;
      padding: 22px;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 18px;
      background: linear-gradient(145deg, var(--surface-raised), var(--surface));
      box-shadow: 0 12px 35px rgba(0, 0, 0, .18);
    }
    .city-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
    .city { margin: 0; font-size: 1.15rem; font-weight: 650; }
    .zone { margin: 4px 0 0; color: var(--muted); font-size: .82rem; }
    .day-state { padding: 4px 8px; border: 1px solid var(--border); border-radius: 999px; color: var(--accent); font-size: .7rem; white-space: nowrap; }
    .time { margin: 20px 0 0; font-variant-numeric: tabular-nums; font-size: clamp(2rem, 5vw, 2.55rem); font-weight: 700; letter-spacing: .025em; line-height: 1; }
    .date { margin: 9px 0 0; color: var(--muted); font-size: .9rem; }
    footer { margin-top: 24px; color: var(--muted); font-size: .8rem; text-align: center; }
    @media (max-width: 520px) { body { padding: 32px 16px; } .clock-card { min-height: 155px; } }
  </style>
</head>
<body>
  <main>
    <header class="heading">
      <div class="eyebrow">Time, around the world</div>
      <h1>World Clock</h1>
      <p class="intro">Live local times in different time zones.</p>
    </header>
    <section class="clock-grid" id="clock-grid" aria-label="Current time in cities around the world"></section>
    <footer>Times update automatically using your device's clock.</footer>
  </main>

  <script>
    const cities = [
      { name: "Los Angeles", zone: "America/Los_Angeles" },
      { name: "New York", zone: "America/New_York" },
      { name: "London", zone: "Europe/London" },
      { name: "Paris", zone: "Europe/Paris" },
      { name: "Dubai", zone: "Asia/Dubai" },
      { name: "Mumbai", zone: "Asia/Kolkata" },
      { name: "Tokyo", zone: "Asia/Tokyo" },
      { name: "Sydney", zone: "Australia/Sydney" }
    ];

    const grid = document.getElementById("clock-grid");
    const timeFormatters = new Map();
    const dateFormatters = new Map();
    const dayFormatters = new Map();

    function getFormatter(cache, zone, options) {
      if (!cache.has(zone)) {
        cache.set(zone, new Intl.DateTimeFormat(undefined, { timeZone: zone, ...options }));
      }
      return cache.get(zone);
    }

    function createClockCard(city) {
      const card = document.createElement("article");
      card.className = "clock-card";
      card.innerHTML = `
        <div class="city-row">
          <div>
            <h2 class="city"></h2>
            <p class="zone"></p>
          </div>
          <span class="day-state"></span>
        </div>
        <p class="time" aria-label="Current time"></p>
        <p class="date"></p>
      `;
      card.querySelector(".city").textContent = city.name;
      card.querySelector(".zone").textContent = city.zone.replaceAll("_", " ");
      grid.appendChild(card);
      return { ...city, card };
    }

    const clocks = cities.map(createClockCard);

    function updateClocks() {
      const now = new Date();
      for (const city of clocks) {
        city.card.querySelector(".time").textContent = getFormatter(timeFormatters, city.zone, {
          hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false
        }).format(now);
        city.card.querySelector(".date").textContent = getFormatter(dateFormatters, city.zone, {
          weekday: "long", year: "numeric", month: "long", day: "numeric"
        }).format(now);
        const hour = Number(getFormatter(dayFormatters, city.zone, {
          hour: "numeric", hourCycle: "h23"
        }).format(now));
        city.card.querySelector(".day-state").textContent = hour >= 6 && hour < 18 ? "DAYTIME" : "NIGHT";
      }
    }

    updateClocks();
    setInterval(updateClocks, 1000);
  </script>
</body>
</html>
